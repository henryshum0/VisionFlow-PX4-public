<?xml version="1.0"?>
<sdf version="1.9">
  <model name="swan_gamma_v2">
    <static>false</static>
    <self_collide>false</self_collide>
    <enable_wind>false</enable_wind>

    <include merge="true">
      <uri>model://swan_uav_v2</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>gamma_arm</name>
      <uri>model://gamma_arm</uri>
      <pose>0.405 -0.015 -0.0295 -2.6443 0 0</pose>
    </include>

    <joint name="swan_uav_arm_joint" type="fixed">
      <parent>base_link</parent>
      <child>gamma_arm::gamma_arm_base_link</child>
    </joint>

    <include>
      <name>gripper4</name>
      <uri>model://gripper4</uri>
      <pose relative_to="gamma_arm::F_Link">-0.003 0 0.025 0 0 0</pose>
    </include>

    <joint name="swan_gripper_joint" type="fixed">
      <parent>gamma_arm::F_Link</parent>
      <child>gripper4::base_link</child>
    </joint>

    <!-- Intel RealSense D435 mounted on gripper4 -->
    <include>
      <name>realsense_d435</name>
      <uri>model://Intel_realsense_d435</uri>
      <pose relative_to="gripper4::base_link">0.040 0 -0.0125 -1.5708 0 -1.5708</pose>
    </include>

    <joint name="gripper_realsense_d435_joint" type="fixed">
      <parent>gripper4::base_link</parent>
      <child>realsense_d435::link</child>
    </joint>

    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><box><size>0.065 0.065 0.060</size></box></geometry>
        <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="housing_collision">
        <geometry><box><size>0.065 0.065 0.060</size></box></geometry>
      </collision>
      <sensor name="lidar_horizontal" type="gpu_lidar">
        <always_on>1</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>/swan_gamma_v2/scan_horizontal</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.141593</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.436332</min_angle>
              <max_angle>0.436332</max_angle>
            </vertical>
          </scan>
          <range><min>1.0</min><max>35.0</max><resolution>0.02</resolution></range>
        </lidar>
      </sensor>
    </link>

    <joint name="base_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- Forward RGB camera. It is mounted ahead of and below the airframe so
         the body/arm stay out of view; its +X optical axis pitches 60° down. -->
    <link name="front_camera_link">
      <pose relative_to="base_link">0.30 0 -0.13 0 1.0471975512 0</pose>
      <inertial>
        <mass>0.0616</mass>
        <inertia>
          <ixx>0.00009</ixx><iyy>0.000003</iyy><izz>0.00009</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><box><size>0.090 0.025 0.025</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <collision name="housing_collision">
        <geometry><box><size>0.090 0.025 0.025</size></box></geometry>
      </collision>
      <sensor name="front_camera" type="camera">
        <always_on>1</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/swan_gamma_v2/front_camera/image</topic>
        <gz_frame_id>front_camera_link</gz_frame_id>
        <camera name="front_camera">
          <!-- 100 degrees, in radians. -->
          <horizontal_fov>1.7453292520</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>50.0</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="base_front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <!-- Third-person chase camera. Its fixed transform follows base_link: it
         sits 6 m behind and 3 m above the vehicle, then looks forward/down at
         the airframe. It has no collision geometry, so it does not affect the
         vehicle's contacts or the simulated map. -->
    <link name="follow_camera_link">
      <pose relative_to="base_link">-6.0 0 3.0 0 0.4636476090 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="follow_camera" type="camera">
        <always_on>1</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/swan_gamma_v2/follow_camera/image</topic>
        <gz_frame_id>follow_camera_link</gz_frame_id>
        <camera name="follow_camera">
          <!-- 70 degrees, in radians; enough context to retain the UAV in view. -->
          <horizontal_fov>1.2217304764</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>100.0</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="base_follow_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>follow_camera_link</child>
    </joint>

  </model>
</sdf>
